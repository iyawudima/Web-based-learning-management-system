rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() { return request.auth != null &&
      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin','lecturer']; }
    function officer() { return request.auth != null &&
      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin','officer']; }
    match /applications/{uid}/{ref}/{f} {
      allow read: if officer();
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
    }
    match /materials/{cid}/{f} {
      allow read: if request.auth != null && (staff() ||
        firestore.exists(/databases/(default)/documents/enrollments/$(cid + '_' + request.auth.uid)));
      allow write: if staff() && request.resource.size < 50 * 1024 * 1024;
    }
    match /submissions/{uid}/{f} {
      allow read: if request.auth != null && (request.auth.uid == uid || staff());
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
